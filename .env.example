# Bearer token Laravel must send (CLAUDE_CODE_SERVICE_KEY on the Laravel side). Empty = no auth.
SERVICE_API_KEY=

# Claude Code auth: set ANTHROPIC_API_KEY, or leave unset to use the local `claude` login.
ANTHROPIC_API_KEY=

# Model used when the request does not send one (sonnet | opus | haiku | full model id).
CLAUDE_DEFAULT_MODEL=sonnet

# Directory Claude Code works in (files it may read/edit).
CLAUDE_CWD=

# Tools Claude Code may use without asking. Anything else is denied (permission mode dontAsk).
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep
CLAUDE_PERMISSION_MODE=dontAsk
CLAUDE_MAX_TURNS=10

# Which settings files to load (user,project,local). Empty = none: faster and isolated.
CLAUDE_SETTING_SOURCES=

# append = Claude Code system prompt + Laravel agent instructions; replace = only Laravel instructions.
CLAUDE_SYSTEM_PROMPT_MODE=append

# Parallel Claude Code processes.
MAX_CONCURRENCY=4

# Extended thinking: empty = Claude Code default (thinking text hidden), adaptive (thinking streamed to UI),
# disabled (fastest first token; honoured by sonnet/opus, haiku still thinks), or a token budget like 4000.
CLAUDE_THINKING=
# Reasoning effort on supported models: low | medium | high | xhigh | max. Empty = default.
CLAUDE_EFFORT=
